# =====================================================================
# SovereignWorkbench / Aquanex — Environment Configuration Template (.env.example)
# Copy this file to .env to configure your local or air-gapped node deployment:
#   cp .env.example .env
# =====================================================================

# --- 3-Node Physical Offline LAN Topology (192.168.1.0/24) ---
SERVER_NODE_IP=192.168.1.100
ADMIN_NODE_IP=192.168.1.101
USER_NODE_IP=192.168.1.102

# --- Inference Engine Host (Ollama / vLLM Server) ---
# For local loopback: http://127.0.0.1:11434
# For dedicated LAN GPU workstation: http://<GPU_NODE_IP>:11434
OLLAMA_HOST=http://127.0.0.1:11434

# --- Open-Weight Model Governance (Sovereign refinery model tier) ---
# Tiers: ENTERPRISE_100B, WORKSTATION_32B, EDGE_LAPTOP_8B
MODEL_TIER=EDGE_LAPTOP_8B
MODEL_ROUTER=qwen2.5:3b
MODEL_REASONING=qwen2.5:3b
MODEL_VISION=qwen2.5:3b
MODEL_CODER=qwen2.5-coder:1.5b

# --- Air-Gap Enforcement Policy ---
# Set to true for physical air-gap lockdown (halts execution if public WAN egress detected)
# Set to false during development on shared network with internet access
AIR_GAP_STRICT=true
ALLOW_EMULATION=false

# --- Execution Sandbox Security Constraints ---
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_MAX_RETRIES=3

# --- Paths & Audit Storage ---
DATA_DIR=data
AUDIT_DB_PATH=data/mrpl_audit.db
CHROMA_PERSIST_DIR=data/chromadb
RAG_DOCS_DIR=rag_docs

# --- Web Service Binding ---
HOST=0.0.0.0
PORT=8000
