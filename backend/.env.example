# =====================================================================
# SovereignWorkbench — Backend Environment Configuration (.env.example)
# Copy to .env to override defaults for on-premise refinery deployment.
# =====================================================================

# --- Ollama GPU Server ---
OLLAMA_HOST=http://localhost:11434

# --- Open-Weight Model Tags (Must match `ollama list`) ---
MODEL_ROUTER=qwen2.5:3b-instruct-q8_0
MODEL_REASONING=deepseek-r1:8b
MODEL_VISION=qwen2-vl:7b-instruct-q4_K_M
MODEL_CODER=qwen2.5-coder:7b-instruct-q4_K_M

# --- File Storage Paths ---
DATA_DIR=data
MODELS_DIR=models_storage
RAG_DOCS_DIR=rag_docs

# --- Sandbox Security Limits ---
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_MAX_RETRIES=3

# --- Sovereign RAG ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=data/chromadb
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# --- Security & Audit Ledger ---
AUDIT_DB_PATH=data/mrpl_audit.db
NETWORK_POLL_INTERVAL_SECONDS=2.0

# --- Server Host & Port ---
HOST=0.0.0.0
PORT=8000
